# ============================================================================
#  BIBLIAN API — variables de entorno
#  Copia este archivo como `.env` y rellena SOLO los valores marcados <RELLENAR>
#  Los que ya traen valor funcionan tal cual en local.
# ============================================================================

# ---------------------------------------------------------------------------
# 1. SERVIDOR  (no requiere cuentas, dejalo asi)
# ---------------------------------------------------------------------------
PORT=3000
NODE_ENV=development

# Origenes permitidos por CORS, separados por coma.
# En produccion agrega el dominio real de la UI.
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# ---------------------------------------------------------------------------
# 2. TURSO — texto biblico, diccionario Strong, usuarios
#    Sacar de: https://app.turso.tech  ->  tu base  ->  boton "Connect"
#    O por CLI:  turso db show biblian --url
#                turso db tokens create biblian
# ---------------------------------------------------------------------------
TURSO_DATABASE_URL=<RELLENAR>          # libsql://biblian-<tu-org>.turso.io
TURSO_AUTH_TOKEN=<RELLENAR>            # eyJhbGciOi... (token largo)

# ---------------------------------------------------------------------------
# 3. AUTENTICACION  (favoritos e historial sincronizados)
#    JWT_SECRET_KEY: genera uno con  ->  openssl rand -hex 48
#    NUNCA reuses el secreto de otro proyecto ni lo subas al repo.
# ---------------------------------------------------------------------------
JWT_SECRET_KEY=<RELLENAR>              # cadena aleatoria larga, minimo 32 chars
JWT_EXPIRATION_TIME=7d
SALT_ROUNDS=10

# ---------------------------------------------------------------------------
# 4. SCALEWAY OBJECT STORAGE — audio MP3 del diccionario Strong
#    Reusa el bucket/llaves de tu proyecto music-api si quieres.
#    Sacar de: https://console.scaleway.com -> Object Storage -> tu bucket
#    Las llaves: IAM -> API Keys -> Generate API key
# ---------------------------------------------------------------------------
SCALEWAY_ENDPOINT=https://s3.fr-par.scw.cloud
SCALEWAY_REGION=fr-par
SCALEWAY_BUCKET_NAME=<RELLENAR>        # ej: biblian-assets
SCALEWAY_ACCESS_KEY_ID=<RELLENAR>      # SCWXXXXXXXXXXXXXXXXX
SCALEWAY_SECRET_ACCESS_KEY=<RELLENAR>  # uuid secreto

# URL publica base desde donde se sirve el audio.
# El bucket debe estar en modo PUBLICO para que el navegador cachee los mp3.
# Formato: https://<bucket>.s3.<region>.scw.cloud
SCALEWAY_PUBLIC_URL=<RELLENAR>         # ej: https://biblian-assets.s3.fr-par.scw.cloud

# Prefijos (carpetas) dentro del bucket. Dejalos asi salvo que ya tengas otra estructura.
STORAGE_AUDIO_GREEK_PREFIX=strongs/audio/greek
STORAGE_AUDIO_HEBREW_PREFIX=strongs/audio/hebrew

# ---------------------------------------------------------------------------
# 5. CLOUDINARY — imagenes (avatares, tarjetas de versiculo para compartir)
#    OPCIONAL: si lo dejas vacio, la API arranca igual y solo desactiva
#    los endpoints de /api/upload. El resto funciona normal.
#    Sacar de: https://console.cloudinary.com -> Dashboard -> API Keys
# ---------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=<RELLENAR-OPCIONAL>
CLOUDINARY_API_KEY=<RELLENAR-OPCIONAL>
CLOUDINARY_API_SECRET=<RELLENAR-OPCIONAL>
CLOUDINARY_FOLDER=biblian
