# ============================================================================
#  UI (Vite) — variables de entorno
#  Copia como `.env` para desarrollo. Todas son OPCIONALES: sin ellas la app
#  usa los valores por defecto que aparecen comentados.
# ============================================================================

# Fuente de datos primaria: "turso" (backend) o "github" (CDN viejo).
# El usuario puede cambiarla en Ajustes; esto solo define el valor inicial.
# VITE_DATA_SOURCE=turso

# Base del backend. En produccion apunta al dominio real de la API.
# VITE_API_URL=http://localhost:3000

# Si la fuente primaria falla, reintenta contra el CDN automaticamente.
# Ponlo en "false" para que un fallo sea visible en vez de enmascararse.
# VITE_AUTO_FALLBACK=true

# CDN de respaldo (los JSON originales en el repo).
# VITE_CDN_URL=https://raw.githubusercontent.com/CristopherPaiz/multi-bible-compare/main/src/assets

# Bucket del audio del diccionario Strong.
# VITE_AUDIO_URL=https://music-fragments.s3.fr-par.scw.cloud

# Proxy CORS del traductor de versiculos (el texto pasa por un tercero).
# VITE_TRANSLATE_PROXY=https://corsproxy.io/
